# ======================================================================
# CampusConnect Backend v2 — Environment Variables
# ======================================================================
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ======================================================================

# App
NODE_ENV=development
PORT=3000
APP_NAME=CampusConnect
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database — PostgreSQL ──────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=campusconnect
DATABASE_PASSWORD=campusconnect_dev
DATABASE_NAME=campusconnect
DATABASE_SSL=false

# Set to 'true' in production to auto-run pending migrations on startup
TYPEORM_RUN_MIGRATIONS=false

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_64_CHAR_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis (BullMQ queues + caching) ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Email (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=CampusConnect <noreply@campusconnect.app>

# ── File Storage (Round 3 — choose one provider) ───────────────────────────
STORAGE_PROVIDER=local          # local | s3 | cloudinary

# AWS S3
AWS_S3_BUCKET=
AWS_S3_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local uploads (dev only)
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=10

# ── Monitoring / Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug          # error | warn | info | http | debug
LOG_DIR=./logs

# ── MFA (Round 2) ───────────────────────────────────────────────────────────
# No env vars needed — TOTP secrets are generated per-user and stored encrypted
# in the database. otplib + qrcode handle the cryptography.
